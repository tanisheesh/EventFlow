# Copy to .env and fill in. Never commit .env.

# Flask & App Config
# SECRET_KEY: long random hex string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# FLASK_ENV: development | testing | production (default: development)
FLASK_ENV=
# FLASK_APP: Flask entry module (default: app.py)
FLASK_APP=
# DATABASE_URL: SQLAlchemy URI (local default: sqlite:///eventhub.db)
DATABASE_URL=
# TEST_DATABASE_URL: SQLAlchemy URI for TestingConfig (default: sqlite:///:memory:)
TEST_DATABASE_URL=
# PORT: HTTP listen port for start.py / app.py (default: 5000)
PORT=

# Reqly (API observability — optional; EventFlow stays fail-open without a collector)
# Run a local collector via `docker compose up -d` in https://github.com/tanisheesh/reqly
# REQLY_COLLECTOR_URL: collector base URL (local compose default: http://localhost:8000)
REQLY_COLLECTOR_URL=
# REQLY_API_KEY: collector REQLY_INGEST_KEY
REQLY_API_KEY=
# REQLY_ENVIRONMENT: environment label (e.g. development | production)
REQLY_ENVIRONMENT=
# REQLY_CONSUMER_SALT: random salt used to hash user IDs before telemetry leaves the app
REQLY_CONSUMER_SALT=
# REQLY_DASHBOARD_URL: Reqly dashboard URL shown to admins (local compose default: http://localhost:5173)
REQLY_DASHBOARD_URL=
# REQLY_SAMPLE_RATE: 0 to 1 sampling rate (set to 0 in tests to disable emission)
REQLY_SAMPLE_RATE=
