# Copy to .env and fill in. Never commit .env.

# Flask
# SECRET_KEY: any long random string, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
FLASK_ENV=development
FLASK_APP=app.py
DATABASE_URL=sqlite:///eventhub.db
PORT=5000

# Reqly (API observability). All optional: with no collector, EventFlow runs
# normally and Reqly stays fail-open. Run a collector with `docker compose up -d`
# in https://github.com/tanisheesh/reqly.
REQLY_COLLECTOR_URL=http://localhost:8000
# REQLY_API_KEY: the collector's REQLY_INGEST_KEY
REQLY_API_KEY=
REQLY_ENVIRONMENT=development
# REQLY_CONSUMER_SALT: a random string; user ids are hashed with it before
# they leave the app
REQLY_CONSUMER_SALT=
# REQLY_DASHBOARD_URL: linked from the admin dashboard, e.g. http://localhost:5173
REQLY_DASHBOARD_URL=
